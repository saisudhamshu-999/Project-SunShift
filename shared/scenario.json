  },
  "policy": {
    "rain_defer_prob": 50,
    "rain_min_mm": 2.0,
    "rain_lookahead_h": 30,
    "observed_rain_skip_mm": 10,
    "fairness_weight": 1.0,
    "catch_up_rate": 0.35,
    "bau": {
      "factor": 1.3,
      "rotation_days": {
        "drip": 1,
        "sprinkler": 2,
        "furrow": 3
      },
      "note": "Business-as-usual: farmers know their crop stage and the season, but not this week's weather or each other's schedules. Each irrigation applies factor x the climatological crop need for the month on a fixed rotation, starts at the farmer's habitual time, and is skipped only after observing heavy rain. Over-application under flat-rate agricultural power is widely reported; the factor is adjustable."
    }
  },
